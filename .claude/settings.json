{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run format)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)",
      "Bash(npx prettier --write:*)",
      "Bash(npx tsc --noEmit:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/doku-erinnerung.sh\"",
            "timeout": 10,
            "statusMessage": "Prüfe, ob die Doku nachzuziehen ist"
          }
        ]
      }
    ]
  }
}
